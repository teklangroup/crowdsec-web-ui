FLEET_SERVER=https://crowdsec.example.com
FLEET_ENROLL_TOKEN=paste-token-from-the-fleet-page
FLEET_TAGS=prod,web

# Optional: the ID of this host's LAPI instance in CrowdSec Web UI, so the
# Fleet page can link to its alerts and decisions.
#FLEET_INSTANCE=web01

# CrowdSec running in Docker instead of a package install:
#FLEET_CSCLI=docker exec crowdsec cscli
#FLEET_RELOAD_CMD=docker restart crowdsec
